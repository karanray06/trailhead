# ============================================================
# Trailhead — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Model (Ollama) ---
# Which model to serve via Ollama. Swap this to try different sizes.
# Examples: gemma3:4b, gemma3:12b, gemma3:27b, llama3.2:3b, phi4-mini
MODEL_NAME=gemma3:4b

# Ollama host (default: local)
OLLAMA_HOST=http://localhost:11434

# --- TabPFN Prediction Service ---
# Path to weather CSV (leave empty to use sample data)
WEATHER_CSV_PATH=

# Port for the prediction service
PREDICT_PORT=8001

# --- ElevenLabs (Voice) ---
# Get your API key at https://elevenlabs.io
# Leave empty to use browser SpeechSynthesis fallback
ELEVENLABS_API_KEY=

# Voice ID (default: a warm, friendly voice)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Sentry (Observability) ---
# Get your DSN at https://sentry.io
SENTRY_DSN=

# --- Frontend ---
VITE_API_URL=http://localhost:3001
VITE_PREDICT_URL=http://localhost:8001

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
